# ── Hermes Agent ──
# Entorno de desarrollo. Copiar a .env y completar.

# Dominio
DOMAIN=adminbot.info
DOMAIN_WWW=www.adminbot.info

# PostgreSQL
POSTGRES_USER=hermes
POSTGRES_PASSWORD=changeme_in_prod
POSTGRES_DB=hermes
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Redis
REDIS_URL=redis://redis:6379/0

# Google Workspace
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/google-service-account.json
GOOGLE_SHEET_ID=your_sheet_id_here
GOOGLE_SHEET_RANGE=Residentes!A:Z
GOOGLE_SHEET_SALDOS_RANGE=Saldos!A:Z

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_CHAT_IDS=123456789
TELEGRAM_PORTERIA_CHAT_IDS=987654321

# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-your_key_here
CLAUDE_MODEL=claude-sonnet-4-20250514

# Seguridad
SECRET_KEY=generate_a_random_secret_key_here
OTP_SALT=generate_a_random_salt_here
CORS_ORIGINS=https://adminbot.info

# Respaldos
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30

# Logging
LOG_LEVEL=INFO
